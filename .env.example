# =============================================================================
# IDPico Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# All variables are optional and have sensible defaults.

# -----------------------------------------------------------------------------
# Server Settings
# -----------------------------------------------------------------------------
IDPICO_HOST=0.0.0.0
IDPICO_PORT=8080
IDPICO_ISSUER_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
IDPICO_STORE_DRIVER=sqlite      # sqlite (default) or file (JSON files)
IDPICO_DATA_DIR=./data          # Holds idpico.db (sqlite) or the JSON files (file)
IDPICO_STORE_DSN=               # Optional: explicit SQLite path (default: <IDPICO_DATA_DIR>/idpico.db)

# -----------------------------------------------------------------------------
# Session Settings
# -----------------------------------------------------------------------------
IDPICO_SESSION_DURATION=24h
IDPICO_COOKIE_SECRET=           # Auto-generated if empty (set for production!)
IDPICO_COOKIE_SECURE=false      # Set to true when using HTTPS
IDPICO_COOKIE_DOMAIN=           # Leave empty for current domain

# -----------------------------------------------------------------------------
# Token Settings
# -----------------------------------------------------------------------------
IDPICO_ACCESS_TOKEN_TTL=15m
IDPICO_REFRESH_TOKEN_TTL=168h   # 7 days
IDPICO_AUTH_CODE_TTL=10m

# -----------------------------------------------------------------------------
# Groups (released to clients in the "groups" claim when the groups scope is granted)
# -----------------------------------------------------------------------------
IDPICO_GROUPS_CLAIM=groups      # Claim name; set e.g. "roles" for apps that expect that
IDPICO_BOOTSTRAP_GROUPS=        # "admins:alice@example.com bob@example.com,devs:carol@example.com"

# -----------------------------------------------------------------------------
# Admin UI (served at /admin)
# -----------------------------------------------------------------------------
IDPICO_ADMIN_EMAILS=            # Comma-separated emails granted admin access on startup
IDPICO_PLAYGROUND_ENABLED=true  # Built-in OIDC test client at /playground (disable for shared deployments)

# -----------------------------------------------------------------------------
# Account Self-Service & Email
# -----------------------------------------------------------------------------
IDPICO_PASSWORD_RESET_TTL=1h    # Lifetime of password reset links
IDPICO_PASSWORD_RESET_INTERVAL=2m # Min gap between self-service reset emails to one address (0 = off)
IDPICO_EMAIL_VERIFY_TTL=24h     # Lifetime of email verification links
IDPICO_MAIL_DRIVER=log          # log = print emails to the server log (dev), smtp = send them
IDPICO_SMTP_HOST=
IDPICO_SMTP_PORT=587
IDPICO_SMTP_USERNAME=
IDPICO_SMTP_PASSWORD=
IDPICO_SMTP_FROM=               # e.g. "IDPico <idp@example.com>" sender address
IDPICO_SMTP_IMPLICIT_TLS=false  # true for servers that expect TLS from the first byte (port 465)

# -----------------------------------------------------------------------------
# Consent
# -----------------------------------------------------------------------------
IDPICO_REQUIRE_CONSENT=true     # Show a consent screen the first time a user authorizes a client
                             # (clients flagged skip_consent never prompt)

# -----------------------------------------------------------------------------
# Key Rotation
# -----------------------------------------------------------------------------
IDPICO_SIGNING_KEY_ROTATION_DAYS=30   # Rotate the signing key after N days (0 = disabled)
IDPICO_SIGNING_KEY_GRACE_PERIOD=24h   # Rotated keys stay in JWKS / verify tokens for this long
IDPICO_MAINTENANCE_INTERVAL=10m       # Purge expired sessions/codes/tokens and run key rotation (0 = disabled)
IDPICO_AUDIT_RETENTION=2160h          # Prune audit log entries older than this (90 days; 0 = keep forever)

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
IDPICO_LOGIN_RATE_LIMIT=5       # Login attempts per minute per IP (0 = disabled)

# -----------------------------------------------------------------------------
# Account Lockout
# -----------------------------------------------------------------------------
IDPICO_LOCKOUT_MAX_ATTEMPTS=5   # Failed attempts before lockout (0 = disabled)
IDPICO_LOCKOUT_DURATION=15m     # How long account stays locked

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Leave empty to disable CORS.
IDPICO_CORS_ALLOWED_ORIGINS=
# Example: IDPICO_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
IDPICO_CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
IDPICO_SECURITY_HEADERS_ENABLED=true
IDPICO_CONTENT_SECURITY_POLICY=default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'
IDPICO_HSTS_MAX_AGE=0           # 0 = disabled, 31536000 = 1 year (recommended for HTTPS)

# -----------------------------------------------------------------------------
# Metrics (Prometheus)
# -----------------------------------------------------------------------------
IDPICO_METRICS_ENABLED=true     # Exposes /metrics endpoint

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
IDPICO_LOG_LEVEL=info           # debug, info, warn, error
IDPICO_LOG_FORMAT=json          # json or text

# -----------------------------------------------------------------------------
# Client Configuration (Simple - Single Client)
# -----------------------------------------------------------------------------
# Use these for a single OAuth client. Takes precedence over IDPICO_BOOTSTRAP_CLIENTS.
IDPICO_CLIENT_ID=my-app
IDPICO_CLIENT_SECRET=my-secret  # Leave empty for public clients (PKCE required)
IDPICO_CLIENT_REDIRECT_URI=http://localhost:3000/callback
# Multiple redirect URIs: IDPICO_CLIENT_REDIRECT_URI=http://localhost:3000/callback http://localhost:3000/silent

# -----------------------------------------------------------------------------
# Client Configuration (Advanced - Multiple Clients)
# -----------------------------------------------------------------------------
# Format: client_id|secret|redirect_uri (comma-separated for multiple clients)
# Empty secret for public clients: public-app||http://localhost:3000/callback
# Multiple redirect URIs: app|secret|http://uri1 http://uri2
# IDPICO_BOOTSTRAP_CLIENTS=app1|secret1|http://localhost:3000/callback,app2||http://localhost:4000/callback

# -----------------------------------------------------------------------------
# Bootstrap Users
# -----------------------------------------------------------------------------
# Format: email:password:name (comma-separated for multiple users)
IDPICO_BOOTSTRAP_USERS=test@example.com:password123:Test User
# Example: IDPICO_BOOTSTRAP_USERS=admin@example.com:admin123:Admin,user@example.com:user123:User
