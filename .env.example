# IDPico — copy to .env next to the binary (or export these) and restart.
# Nothing else is required: the server listens on http://localhost:8080 and
# keeps its SQLite database in ./data. Full reference: docs/configuration.md

# The first user, and who may open the admin console at /admin.
IDPICO_BOOTSTRAP_USERS=you@example.com:change-me:Your Name
IDPICO_ADMIN_EMAILS=you@example.com

# Your application as an OIDC client: id|secret|redirect URI
# (leave the secret empty for a public/PKCE client: my-spa||http://localhost:5173/callback).
IDPICO_BOOTSTRAP_CLIENTS=my-app|my-app-secret|http://localhost:3000/callback

# For anything reachable by other people, also set (see README, "Running it on a shared host"):
# IDPICO_ISSUER_URL=https://idp.example.com
# IDPICO_COOKIE_SECRET=<random 32+ bytes>
# IDPICO_TRUSTED_PROXIES=private
